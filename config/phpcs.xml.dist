<?xml version="1.0"?>
<ruleset name="ASODELTOL Moodle plugins">
  <description>Validación de estilo para plugins propios de ASODELTOL.</description>

  <file>../plugins</file>
  <arg name="extensions" value="php"/>
  <arg name="colors"/>
  <arg value="sp"/>

  <rule ref="moodle"/>

  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/build/*</exclude-pattern>
</ruleset>

