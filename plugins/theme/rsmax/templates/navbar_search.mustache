{{!
    @template theme_rsmax/navbar_search

    Search form for the navigation bar. Inline on wide screens; behind a button on narrow ones.

    Context variables required for this template:
    * action - URL the form is sent to
    * inputname - name of the query parameter
    * placeholder - placeholder and accessible label of the input

    Example context (json):
    {
        "action": "https://moodle.local/course/search.php",
        "inputname": "search",
        "placeholder": "Search courses"
    }
}}
<div class="rsmax-search d-flex align-items-center">
    <button class="btn btn-icon rsmax-search-toggle d-lg-none" type="button"
            data-bs-toggle="collapse" data-bs-target="#rsmax-search-{{uniqid}}"
            aria-expanded="false" aria-controls="rsmax-search-{{uniqid}}"
            title="{{#str}} togglesearch, core {{/str}}">
        {{#pix}} a/search, core {{/pix}}
        <span class="visually-hidden">{{#str}} togglesearch, core {{/str}}</span>
    </button>
    <form id="rsmax-search-{{uniqid}}" class="rsmax-search-form collapse d-lg-flex" action="{{action}}" method="get"
          accept-charset="utf-8" role="search">
        <label class="visually-hidden" for="rsmax-search-input-{{uniqid}}">{{placeholder}}</label>
        <span class="rsmax-search-icon" aria-hidden="true">{{#pix}} a/search, core {{/pix}}</span>
        <input id="rsmax-search-input-{{uniqid}}" class="form-control" type="search" name="{{inputname}}"
               placeholder="{{placeholder}}" autocomplete="off">
    </form>
</div>
