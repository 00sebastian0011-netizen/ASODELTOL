{{!
    @template theme_rsmax/block_video

    A video. Videos from YouTube or Vimeo are loaded only when the visitor presses play; video
    files are played by the browser.

    Context variables required for this template:
    * isframe, isfile - which kind of video it is
    * src - address of the player or of the file
    * poster - image shown before playing, may be empty

    Example context (json):
    {
        "isframe": true,
        "isfile": false,
        "src": "https://www.youtube-nocookie.com/embed/abc123",
        "poster": ""
    }
}}
{{#isframe}}
    {{< theme_rsmax/block_embed }}
        {{$src}}{{src}}{{/src}}
        {{$poster}}{{poster}}{{/poster}}
        {{$title}}{{#str}} video, theme_rsmax {{/str}}{{/title}}
        {{$label}}{{#str}} video:play, theme_rsmax {{/str}}{{/label}}
        {{$notice}}{{#str}} video:notice, theme_rsmax {{/str}}{{/notice}}
    {{/ theme_rsmax/block_embed }}
{{/isframe}}
{{#isfile}}
    <div class="pluginia-embed">
        <video controls preload="none" {{#poster}}poster="{{poster}}"{{/poster}} src="{{src}}"></video>
    </div>
{{/isfile}}
