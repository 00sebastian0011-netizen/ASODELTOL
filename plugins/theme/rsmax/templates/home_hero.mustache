{{!
    @template theme_rsmax/home_hero

    The opening of the site home when it has no landing blocks.

    Context variables required for this template:
    * title - title, already formatted
    * text - line under the title, HTML; empty for none
    * cansearch - whether the search box is shown
    * searchurl - where the search is sent
    * coursesurl - address of the course catalogue
    * secondurl, secondtext - the second button: the dashboard, or the login page

    Example context (json):
    {
        "title": "Learn at your own pace",
        "text": "Practical courses with progress tracking.",
        "cansearch": true,
        "searchurl": "#",
        "coursesurl": "#",
        "secondurl": "#",
        "secondtext": "Dashboard"
    }
}}
<section class="rsmax-homehero d-print-none" aria-labelledby="rsmax-homehero-title">
    <div class="rsmax-homehero-inner">
        <h1 id="rsmax-homehero-title" class="rsmax-homehero-title">{{{title}}}</h1>
        {{#text}}<p class="rsmax-homehero-text">{{{text}}}</p>{{/text}}
        {{#cansearch}}
            <form class="rsmax-homehero-search" action="{{searchurl}}" method="get" accept-charset="utf-8" role="search">
                <label class="visually-hidden" for="rsmax-homehero-input">{{#str}} searchcourses, core {{/str}}</label>
                <span class="rsmax-homehero-icon" aria-hidden="true">{{#pix}} a/search, core {{/pix}}</span>
                <input id="rsmax-homehero-input" class="form-control" type="search" name="search"
                       placeholder="{{#str}} searchcourses, core {{/str}}" autocomplete="off">
                <button class="btn btn-primary" type="submit">{{#str}} search, core {{/str}}</button>
            </form>
        {{/cansearch}}
        <div class="rsmax-homehero-actions">
            <a class="btn btn-primary" href="{{coursesurl}}">{{#str}} fulllistofcourses, core {{/str}}</a>
            <a class="btn btn-outline-light" href="{{secondurl}}">{{secondtext}}</a>
        </div>
    </div>
</section>
