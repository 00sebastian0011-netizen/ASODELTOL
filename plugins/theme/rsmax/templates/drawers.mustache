{{!
    @template theme_rsmax/drawers

    Page shell for the drawers layout. It is Boost's drawers template with the RSMAX navigation
    bar, the landing block regions, the course progress and the site footer.

    Context variables required for this template:
    * sitename - The name of the site
    * output - The core renderer for the page
    * bodyattributes - attributes for the body tag as a string of html attributes
    * sidepreblocks - HTML for the blocks
    * hasblocks - true if there are blocks on this page
    * courseindexopen - true if the nav drawer should be open on page load
    * regionmainsettingsmenu - HTML for the region main settings menu
    * hasregionmainsettingsmenu - There is a region main settings menu on this page.
    * regions - landing regions, each one false or an object with html and label
    * progress - false, or the context of theme_rsmax/course_progress
    * stage - false, or the context of theme_rsmax/activity_stage_top and activity_stage_route
    * footer - the context of theme_rsmax/footer
    * dashboard - false, or the context of theme_rsmax/dashboard
    * coursehero - false, or the context of theme_rsmax/course_hero
    * navbar - style, isdark and button of the navigation bar

    Example context (json):
    {
        "sitename": "Moodle",
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Test page",
            "favicon": "favicon.ico",
            "main_content": "<h1>Headings make html validators happier</h1>"
         },
        "bodyattributes":"",
        "sidepreblocks": "<h2>Blocks html goes here</h2>",
        "hasblocks":true,
        "courseindexopen": true,
        "blockdraweropen": true,
        "regionmainsettingsmenu": "",
        "hasregionmainsettingsmenu": false,
        "addblockbutton": "",
        "regions": {"fullwidthtop": false, "abovecontent": false, "belowcontent": false, "fullwidthbottom": false},
        "progress": false,
        "stage": false,
        "dashboard": false,
        "coursehero": false,
        "footer": {"style": "dark", "text": "", "copyright": "2026 Moodle", "columns": [], "social": [], "hassocial": false, "sitename": "Moodle"},
        "navbar": {"style": "light", "isdark": false, "button": false}
    }
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block">

    {{{ output.standard_top_of_body_html }}}

    {{> theme_rsmax/navbar }}
    {{#courseindex}}
        {{< theme_boost/drawer }}
            {{$id}}theme_boost-drawers-courseindex{{/id}}
            {{$drawerheading}}{{> theme_boost/courseindexdrawerheading}}{{/drawerheading}}
            {{$drawercontrols}}{{> theme_boost/courseindexdrawercontrols}}{{/drawercontrols}}
            {{$drawerclasses}}drawer drawer-left {{#courseindexopen}}show{{/courseindexopen}}{{/drawerclasses}}
            {{$drawercontent}}
                {{{courseindex}}}
            {{/drawercontent}}
            {{$drawerpreferencename}}drawer-open-index{{/drawerpreferencename}}
            {{$drawerstate}}show-drawer-left{{/drawerstate}}
            {{$tooltipplacement}}right{{/tooltipplacement}}
            {{$closebuttontext}}{{#str}}closecourseindex, core{{/str}}{{/closebuttontext}}
            {{$closebuttonicon}}
                <span class="dir-rtl-hide">{{#pix}} e/sidebar_left, core {{/pix}}</span>
                <span class="dir-ltr-hide">{{#pix}} e/sidebar_right, core {{/pix}}</span>
            {{/closebuttonicon}}
        {{/ theme_boost/drawer}}
    {{/courseindex}}
    {{#hasblocks}}
        {{< theme_boost/drawer }}
            {{$id}}theme_boost-drawers-blocks{{/id}}
            {{$drawerclasses}}drawer drawer-right{{#blockdraweropen}} show{{/blockdraweropen}}{{/drawerclasses}}
            {{$drawercontent}}
                <div class="d-print-none">
                    {{{ addblockbutton }}}
                    {{{ sidepreblocks }}}
                </div>
            {{/drawercontent}}
            {{$drawerpreferencename}}drawer-open-block{{/drawerpreferencename}}
            {{$forceopen}}{{#forceblockdraweropen}}1{{/forceblockdraweropen}}{{/forceopen}}
            {{$drawerstate}}show-drawer-right{{/drawerstate}}
            {{$tooltipplacement}}left{{/tooltipplacement}}
            {{$drawercloseonresize}}1{{/drawercloseonresize}}
            {{$closebuttontext}}{{#str}}closeblockdrawer, core{{/str}}{{/closebuttontext}}
            {{$closebuttonicon}}
                <span class="dir-rtl-hide">{{#pix}} e/sidebar_right, core {{/pix}}</span>
                <span class="dir-ltr-hide">{{#pix}} e/sidebar_left, core {{/pix}}</span>
            {{/closebuttonicon}}
        {{/ theme_boost/drawer}}
    {{/hasblocks}}
    <div id="page" data-region="mainpage" data-usertour="scroller" class="drawers {{#courseindexopen}}show-drawer-left{{/courseindexopen}} {{#blockdraweropen}}show-drawer-right{{/blockdraweropen}} drag-container">
        <div id="topofscroll" class="main-inner">
            <div class="drawer-toggles d-flex">
                {{#courseindex}}
                    <div class="drawer-toggler drawer-left-toggle open-nav d-print-none">
                        <button
                            class="btn btn-icon icon-size-3"
                            data-toggler="drawers"
                            data-action="toggle"
                            data-target="theme_boost-drawers-courseindex"
                            data-bs-toggle="tooltip"
                            data-bs-placement="right"
                            title="{{#str}}opendrawerindex, core{{/str}}"
                        >
                            <span class="visually-hidden">{{#str}}opendrawerindex, core{{/str}}</span>
                            <span class="dir-rtl-hide">{{#pix}} e/sidebar_left, core {{/pix}}</span>
                            <span class="dir-ltr-hide">{{#pix}} e/sidebar_right, core {{/pix}}</span>
                        </button>
                    </div>
                {{/courseindex}}
                {{#hasblocks}}
                    <div class="drawer-toggler drawer-right-toggle ms-auto d-print-none">
                        <button
                            class="btn btn-icon icon-size-3"
                            data-toggler="drawers"
                            data-action="toggle"
                            data-target="theme_boost-drawers-blocks"
                            data-bs-toggle="tooltip"
                            data-bs-placement="right"
                            title="{{#str}}opendrawerblocks, core{{/str}}"
                        >
                            <span class="visually-hidden">{{#str}}opendrawerblocks, core{{/str}}</span>
                            <span class="dir-rtl-hide">{{#pix}} e/sidebar_right, core {{/pix}}</span>
                            <span class="dir-ltr-hide">{{#pix}} e/sidebar_left, core {{/pix}}</span>
                        </button>
                    </div>
                {{/hasblocks}}
            </div>
            {{#coursejson}}<script type="application/json" id="rsmax-coursedata">{{{coursejson}}}</script>{{/coursejson}}
            {{#homehero}}{{> theme_rsmax/home_hero }}{{/homehero}}
            {{#regions.fullwidthtop}}{{> theme_rsmax/region }}{{/regions.fullwidthtop}}
            {{#dashboard}}{{> theme_rsmax/dashboard }}{{/dashboard}}
            {{#stage}}
                <div class="rsmax-stage rsmax-stage-{{purpose}}{{#banner}} rsmax-hasbanner{{/banner}}" data-position="{{positionlabel}}"
                     {{#banner}}style="--rsmax-banner: url('{{banner}}')"{{/banner}}>
                    {{> theme_rsmax/activity_stage_top }}
                    {{{ output.full_header }}}
                    {{#hasstops}}{{> theme_rsmax/activity_stage_route }}{{/hasstops}}
                </div>
            {{/stage}}
            {{#sectionstage}}
                <div class="rsmax-stage rsmax-stage-section{{#banner}} rsmax-hasbanner{{/banner}}" data-position="{{positionlabel}}"
                     {{#banner}}style="--rsmax-banner: url('{{banner}}')"{{/banner}}>
                    {{> theme_rsmax/section_stage_top }}
                    {{{ output.full_header }}}
                    {{> theme_rsmax/section_stage_route }}
                </div>
            {{/sectionstage}}
            {{^stage}}{{^sectionstage}}
                {{#progress}}{{#iscompact}}{{> theme_rsmax/course_progress }}{{/iscompact}}{{/progress}}
                {{{ output.full_header }}}
            {{/sectionstage}}{{/stage}}
            {{#coursehero}}{{> theme_rsmax/course_hero }}{{/coursehero}}
            {{#enrol}}{{> theme_rsmax/enrol_hero }}{{/enrol}}
            {{#progress}}{{^iscompact}}{{> theme_rsmax/course_progress }}{{/iscompact}}{{/progress}}
            {{#secondarymoremenu}}
                <div class="secondary-navigation d-print-none">
                    {{> core/secondarymoremenu}}
                </div>
            {{/secondarymoremenu}}
            <div id="page-content" class="pb-3 d-print-block">
                <div id="region-main-box">
                    {{#hasregionmainsettingsmenu}}
                    <div id="region-main-settings-menu" class="d-print-none">
                        <div> {{{ regionmainsettingsmenu }}} </div>
                    </div>
                    {{/hasregionmainsettingsmenu}}
                    <div id="region-main">

                        {{#hasregionmainsettingsmenu}}
                            <div class="region_main_settings_menu_proxy"></div>
                        {{/hasregionmainsettingsmenu}}
                        {{#regions.abovecontent}}{{> theme_rsmax/region }}{{/regions.abovecontent}}
                        {{{ output.course_content_header }}}
                        {{#headercontent}}
                            {{> core/activity_header }}
                        {{/headercontent}}
                        {{#overflow}}
                            <div class="container-fluid tertiary-navigation">
                                <div class="navitem">
                                    {{> core/tertiary_navigation_selector}}
                                </div>
                            </div>
                        {{/overflow}}
                        {{#gradeoverview}}{{> theme_rsmax/grade_overview }}{{/gradeoverview}}
                        {{#enrol}}
                            <div class="rsmax-enrol">
                                <div class="rsmax-enrol-about">{{> theme_rsmax/enrol_about }}</div>
                                <aside class="rsmax-enrol-side" aria-label="{{#str}} enrolmentoptions, enrol {{/str}}">
                                    <div class="rsmax-enrol-card">
                                        <div class="rsmax-enrol-cardimage" style="background-image: url('{{image}}')"></div>
                                        <div class="rsmax-enrol-price">
                                            {{#isfree}}{{#str}} enrolfree, theme_rsmax {{/str}}{{/isfree}}
                                            {{^isfree}}{{price}}{{/isfree}}
                                        </div>
                                        {{#deadline}}
                                            <p class="rsmax-enrol-deadline">
                                                <i class="fa fa-clock" aria-hidden="true"></i>
                                                {{#str}} enroldeadline, theme_rsmax, {{deadline}} {{/str}}
                                            </p>
                                        {{/deadline}}
                                        <div class="rsmax-maincontent">{{{ output.main_content }}}</div>
                                        {{#hasdetails}}
                                            <dl class="rsmax-enrol-details">
                                                {{#details}}<div><dt>{{{name}}}</dt><dd>{{{value}}}</dd></div>{{/details}}
                                            </dl>
                                        {{/hasdetails}}
                                        {{#hasfacts}}
                                            <ul class="rsmax-enrol-includes list-unstyled">
                                                {{#facts}}<li><i class="fa {{icon}}" aria-hidden="true"></i> {{#isdate}}{{label}} <b>{{value}}</b>{{/isdate}}{{^isdate}}<b>{{value}}</b> {{label}}{{/isdate}}</li>{{/facts}}
                                            </ul>
                                        {{/hasfacts}}
                                    </div>
                                </aside>
                            </div>
                            {{#blocks}}<div class="rsmax-enrol-blocks">{{{blocks}}}</div>{{/blocks}}
                        {{/enrol}}
                        {{^enrol}}<div class="rsmax-maincontent">{{{ output.main_content }}}</div>{{/enrol}}
                        {{{ output.activity_navigation }}}
                        {{{ output.course_content_footer }}}
                        {{#regions.belowcontent}}{{> theme_rsmax/region }}{{/regions.belowcontent}}
                        {{#enrolregion}}
                            <div class="rsmax-region-wrapper rsmax-region-editing rsmax-enrolregion d-print-none">
                                <div class="rsmax-region-label">{{label}}</div>
                                <p class="rsmax-region-help">{{help}}</p>
                                {{{html}}}
                            </div>
                        {{/enrolregion}}

                    </div>
                </div>
            </div>
            {{#regions.fullwidthbottom}}{{> theme_rsmax/region }}{{/regions.fullwidthbottom}}
        </div>
        {{> theme_boost/footer }}
    </div>
    {{#footer}}{{> theme_rsmax/footer }}{{/footer}}
    {{#assistantholder}}<div class="rsmax-assistant-holder" hidden>{{{assistantholder}}}</div>{{/assistantholder}}
    {{{ output.standard_after_main_region_html }}}
</div>

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader', 'theme_boost/drawer'], function(Loader, Drawer) {
    Drawer.init();
    M.util.js_complete('theme_boost/loader');
});
{{/js}}
