{{!
    @template theme_rsmax/support_widget

    Floating support character widget that guides authenticated users to internal messaging with Admin or CAU support tickets.

    Context variables required for this template:
    * messageurl - Internal URL to Moodle messaging (/message/index.php)
    * supporturl - Internal URL to the CAU support ticket page (/local/asodeltolstaff/support.php)
    * helpurl - Internal URL to the platform help guide (/local/asodeltolstaff/help.php)

    Example context (json):
    {
        "messageurl": "/message/index.php",
        "supporturl": "/local/asodeltolstaff/support.php",
        "helpurl": "/local/asodeltolstaff/help.php"
    }
}}
<details class="rsmax-support-widget d-print-none">
    <summary class="rsmax-support-trigger" aria-label="{{#str}} supportwidgetaria, theme_rsmax {{/str}}">
        <span class="rsmax-support-mascot" aria-hidden="true">
            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="32" cy="32" r="30" fill="#E8F5F0"/>
                <path d="M14 31C14 21.0589 22.0589 13 32 13C41.9411 13 50 21.0589 50 31" stroke="#104B38" stroke-width="4" stroke-linecap="round"/>
                <circle cx="32" cy="34" r="14" fill="#FFD8B4"/>
                <path d="M20 29C21.5 22.5 26.5 19 32.5 19C38.5 19 43 22.5 44 29C41 26.5 36.8 25 32 25C27.2 25 23 26.5 20 29Z" fill="#1B5E49"/>
                <circle cx="27" cy="33" r="2" fill="#10372A"/>
                <circle cx="37" cy="33" r="2" fill="#10372A"/>
                <path d="M27.5 39C29 41 35 41 36.5 39" stroke="#10372A" stroke-width="2.2" stroke-linecap="round"/>
                <rect x="11" y="28" width="6" height="11" rx="3" fill="#F27E0C"/>
                <rect x="47" y="28" width="6" height="11" rx="3" fill="#F27E0C"/>
                <path d="M49 38C49 44 43 46 36 46" stroke="#104B38" stroke-width="2.5" stroke-linecap="round"/>
                <circle cx="35" cy="46" r="2.5" fill="#F27E0C"/>
                <path d="M18 55C20.5 49.5 25.8 47 32 47C38.2 47 43.5 49.5 46 55" fill="#1B5E49"/>
            </svg>
            <span class="rsmax-support-online"></span>
        </span>
        <span class="rsmax-support-pill">{{#str}} supportwidgettrigger, theme_rsmax {{/str}}</span>
    </summary>
    <div class="rsmax-support-card" role="region" aria-label="{{#str}} supportwidgettitle, theme_rsmax {{/str}}">
        <div class="rsmax-support-header">
            <div class="rsmax-support-header-avatar" aria-hidden="true">
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="32" cy="32" r="30" fill="#E8F5F0"/>
                    <path d="M14 31C14 21.0589 22.0589 13 32 13C41.9411 13 50 21.0589 50 31" stroke="#104B38" stroke-width="4" stroke-linecap="round"/>
                    <circle cx="32" cy="34" r="14" fill="#FFD8B4"/>
                    <path d="M20 29C21.5 22.5 26.5 19 32.5 19C38.5 19 43 22.5 44 29C41 26.5 36.8 25 32 25C27.2 25 23 26.5 20 29Z" fill="#1B5E49"/>
                    <circle cx="27" cy="33" r="2" fill="#10372A"/>
                    <circle cx="37" cy="33" r="2" fill="#10372A"/>
                    <path d="M27.5 39C29 41 35 41 36.5 39" stroke="#10372A" stroke-width="2.2" stroke-linecap="round"/>
                    <rect x="11" y="28" width="6" height="11" rx="3" fill="#F27E0C"/>
                    <rect x="47" y="28" width="6" height="11" rx="3" fill="#F27E0C"/>
                    <path d="M49 38C49 44 43 46 36 46" stroke="#104B38" stroke-width="2.5" stroke-linecap="round"/>
                    <circle cx="35" cy="46" r="2.5" fill="#F27E0C"/>
                    <path d="M18 55C20.5 49.5 25.8 47 32 47C38.2 47 43.5 49.5 46 55" fill="#1B5E49"/>
                </svg>
            </div>
            <div class="rsmax-support-header-copy">
                <div class="rsmax-support-title">{{#str}} supportwidgettitle, theme_rsmax {{/str}}</div>
                <div class="rsmax-support-status">
                    <span class="rsmax-support-status-dot" aria-hidden="true"></span>
                    {{#str}} supportwidgetstatus, theme_rsmax {{/str}}
                </div>
            </div>
        </div>
        <div class="rsmax-support-body">
            <p class="rsmax-support-bubble">{{#str}} supportwidgetgreeting, theme_rsmax {{/str}}</p>
            <div class="rsmax-support-actions">
                <a class="rsmax-support-action rsmax-support-action-chat" href="{{messageurl}}">
                    <span class="rsmax-support-action-icon" aria-hidden="true">
                        <i class="fa fa-comments"></i>
                    </span>
                    <span class="rsmax-support-action-text">
                        <strong>{{#str}} supportwidgetchat, theme_rsmax {{/str}}</strong>
                        <small>{{#str}} supportwidgetchatdesc, theme_rsmax {{/str}}</small>
                    </span>
                    <i class="fa fa-chevron-right rsmax-support-action-arrow" aria-hidden="true"></i>
                </a>
                <a class="rsmax-support-action rsmax-support-action-ticket" href="{{supporturl}}">
                    <span class="rsmax-support-action-icon" aria-hidden="true">
                        <i class="fa fa-life-ring"></i>
                    </span>
                    <span class="rsmax-support-action-text">
                        <strong>{{#str}} supportwidgetticket, theme_rsmax {{/str}}</strong>
                        <small>{{#str}} supportwidgetticketdesc, theme_rsmax {{/str}}</small>
                    </span>
                    <i class="fa fa-chevron-right rsmax-support-action-arrow" aria-hidden="true"></i>
                </a>
            </div>
            <div class="rsmax-support-footer">
                <a class="rsmax-support-guide" href="{{helpurl}}">
                    <i class="fa fa-circle-question" aria-hidden="true"></i>
                    {{#str}} supportwidgetguide, theme_rsmax {{/str}}
                </a>
            </div>
        </div>
    </div>
</details>
