{{!
    This file is part of Moodle - http://moodle.org/
    @template theme_rsmax/course_utilities
    Display-only institutional notice and links. Disabled entries are not anchors.
}}
<section class="rsmax-courseutilities" aria-label="{{#str}}coursequicktitle, theme_rsmax{{/str}}">
    <p class="rsmax-courseutilities-free">{{#str}}coursefreeannouncement, theme_rsmax{{/str}}</p>
    <section class="rsmax-courseutilities-consent" aria-labelledby="rsmax-course-consent-title">
        <div class="rsmax-courseutilities-consentcopy">
            <h2 class="rsmax-courseutilities-consenttitle" id="rsmax-course-consent-title">
                <i class="fa fa-shield-alt" aria-hidden="true"></i>
                {{#str}}courseconsenttitle, theme_rsmax{{/str}}
            </h2>
            <p class="rsmax-courseutilities-consenttext">{{#str}}courseconsentdescription, theme_rsmax{{/str}}</p>
        </div>
        {{#policyurl}}
            <a class="rsmax-courseutilities-consentaction" href="{{policyurl}}">
                {{#str}}courseconsentaction, theme_rsmax{{/str}}
            </a>
        {{/policyurl}}
        {{^policyurl}}
            <span class="rsmax-courseutilities-pending">{{#str}}courseconsentmissing, theme_rsmax{{/str}}</span>
        {{/policyurl}}
    </section>
    <nav class="rsmax-courseutilities-links" aria-labelledby="rsmax-course-quicktitle">
        <h2 class="rsmax-courseutilities-linkstitle" id="rsmax-course-quicktitle">
            {{#str}}coursequicktitle, theme_rsmax{{/str}}
        </h2>
        {{#manageurl}}
            <div class="rsmax-courseutilities-manage">
                <a class="btn btn-outline-primary btn-sm" href="{{manageurl}}">
                    <i class="fa fa-gear" aria-hidden="true"></i>
                    {{#str}}coursequickadmin, theme_rsmax{{/str}}
                </a>
            </div>
        {{/manageurl}}
        <div class="rsmax-courseutilities-grid">
            {{#items}}
                <div class="rsmax-courseutilities-item">
                    {{#url}}
                        <a class="rsmax-courseutilities-link" href="{{url}}">
                            <i class="fa {{icon}}" aria-hidden="true"></i><span>{{label}}</span>
                        </a>
                    {{/url}}
                    {{^url}}
                        <span class="rsmax-courseutilities-disabled">
                            <i class="fa {{icon}}" aria-hidden="true"></i><span>{{label}}</span>
                        </span>
                        <span class="rsmax-courseutilities-help">{{#str}}coursequickmissing, theme_rsmax{{/str}}</span>
                    {{/url}}
                </div>
            {{/items}}
        </div>
    </nav>
</section>
