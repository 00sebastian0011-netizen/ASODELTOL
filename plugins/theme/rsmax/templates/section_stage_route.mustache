{{!
    @template theme_rsmax/section_stage_route

    Last line of the header of a section page: the sections on either side and how much of this
    one the learner has done.

    Context variables required for this template:
    * previous, next - false, or a section (name and url)
    * hasprogress, completed, activities, percentage, iscomplete - progress in the section

    Example context (json):
    {
        "previous": {"name": "Basics", "url": "#"},
        "next": {"name": "Follow-up", "url": "#"},
        "hasprogress": true,
        "completed": 2,
        "activities": 4,
        "percentage": 50,
        "iscomplete": false
    }
}}
<nav class="rsmax-stage-route rsmax-stage-sections d-print-none" aria-label="{{#str}} sectionnavigation, theme_rsmax {{/str}}">
    <div class="rsmax-stage-side">
        {{#previous}}
            <a href="{{url}}">
                <i class="fa fa-arrow-left" aria-hidden="true"></i>
                <span class="visually-hidden">{{#str}} previous, core {{/str}}:</span>
                <span class="rsmax-stage-sidename">{{{name}}}</span>
            </a>
        {{/previous}}
    </div>
    {{#hasprogress}}
        <div class="rsmax-stage-sectionprogress{{#iscomplete}} is-complete{{/iscomplete}}" role="progressbar"
             aria-valuenow="{{percentage}}" aria-valuemin="0" aria-valuemax="100"
             aria-label="{{#str}} yourprogress, theme_rsmax {{/str}}">
            <span class="rsmax-stage-progressbar" aria-hidden="true"><span style="width: {{percentage}}%"></span></span>
            <span>{{#str}} progresscount, theme_rsmax, { "completed": {{completed}}, "total": {{activities}} } {{/str}}</span>
        </div>
    {{/hasprogress}}
    <div class="rsmax-stage-side rsmax-stage-side-end">
        {{#next}}
            <a href="{{url}}">
                <span class="visually-hidden">{{#str}} next, core {{/str}}:</span>
                <span class="rsmax-stage-sidename">{{{name}}}</span>
                <i class="fa fa-arrow-right" aria-hidden="true"></i>
            </a>
        {{/next}}
    </div>
</nav>
