{{!
    @template theme_rsmax/block_carousel_js

    Starts the carousels of the page. Include it after a block that has iscarousel set.

    Context variables required for this template:
    * iscarousel - true when the block is a carousel

    Example context (json):
    {
        "iscarousel": true
    }
}}
{{#iscarousel}}
{{#js}}
require(['theme_rsmax/carousel'], function(Carousel) {
    Carousel.init('[data-region="pluginia-carousel"]');
});
{{/js}}
{{/iscarousel}}
