{{!
    @template theme_rsmax/course_card

    One course of the catalogue, a category or the search results, as a card.

    Context variables required for this template:
    * id, name, url, image - the course
    * category, summary, teachers, price - optional details, empty to leave them out
    * hasprogress, progress - progress of the current user
    * hidden - true when the course is hidden from students

    Example context (json):
    {
        "id": 2,
        "name": "Project management",
        "url": "#",
        "image": "https://placekitten.com/600/340",
        "category": "Business",
        "summary": "From idea to result.",
        "teachers": "Ana Lopez",
        "price": "",
        "hasprogress": true,
        "progress": 40,
        "hidden": false
    }
}}
<div class="coursebox rsmax-coursecard{{#hidden}} is-hidden{{/hidden}}" data-courseid="{{id}}" data-type="1">
    <a class="rsmax-coursecard-image" href="{{url}}" tabindex="-1" aria-hidden="true">
        <img src="{{image}}" alt="" loading="lazy">
        {{#price}}<span class="rsmax-coursecard-price">{{price}}</span>{{/price}}
    </a>
    <div class="rsmax-coursecard-body">
        {{#category}}<div class="rsmax-coursecard-category">{{{category}}}</div>{{/category}}
        <h3 class="rsmax-coursecard-name"><a class="aalink" href="{{url}}">{{{name}}}</a></h3>
        {{#summary}}<p class="rsmax-coursecard-summary">{{summary}}</p>{{/summary}}
        <div class="rsmax-coursecard-foot">
            {{#teachers}}
                <span class="rsmax-coursecard-teachers"><i class="fa fa-chalkboard-user" aria-hidden="true"></i> {{{teachers}}}</span>
            {{/teachers}}
            {{#hidden}}<span class="badge text-bg-secondary">{{#str}} hiddenfromstudents, core {{/str}}</span>{{/hidden}}
        </div>
        {{#hasprogress}}
            <div class="rsmax-coursecard-progress">
                <div class="progress" role="progressbar" aria-valuenow="{{progress}}" aria-valuemin="0" aria-valuemax="100"
                     aria-label="{{#str}} yourprogress, theme_rsmax {{/str}}">
                    <div class="progress-bar" style="width: {{progress}}%"></div>
                </div>
                <span>{{progress}}%</span>
            </div>
        {{/hasprogress}}
    </div>
</div>
