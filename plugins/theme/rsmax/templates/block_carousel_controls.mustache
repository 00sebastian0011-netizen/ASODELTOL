{{!
    @template theme_rsmax/block_carousel_controls

    Previous, next and pause buttons of a Pluginia carousel. They go inside an element with
    data-region="pluginia-carousel" that also holds the scrolling row (data-region="track").

    Context variables required for this template:
    * autoplay - milliseconds between automatic advances, 0 to disable (hides the pause button)

    Example context (json):
    {
        "autoplay": 5000
    }
}}
<div class="pluginia-carousel-controls">
    {{#autoplay}}
        <button type="button" class="btn btn-icon pluginia-carousel-toggle" data-action="toggle-autoplay" aria-pressed="false"
                title="{{#str}} carousel:pause, theme_rsmax {{/str}}">
            <i class="icon fa fa-pause fa-fw pluginia-carousel-pause" aria-hidden="true"></i>
            <i class="icon fa fa-play fa-fw pluginia-carousel-play" aria-hidden="true"></i>
            <span class="visually-hidden">{{#str}} carousel:pause, theme_rsmax {{/str}}</span>
        </button>
    {{/autoplay}}
    <button type="button" class="btn btn-icon" data-action="previous" title="{{#str}} previous, core {{/str}}">
        <i class="icon fa fa-chevron-left fa-fw dir-rtl-hide" aria-hidden="true"></i>
        <i class="icon fa fa-chevron-right fa-fw dir-ltr-hide" aria-hidden="true"></i>
        <span class="visually-hidden">{{#str}} previous, core {{/str}}</span>
    </button>
    <button type="button" class="btn btn-icon" data-action="next" title="{{#str}} next, core {{/str}}">
        <i class="icon fa fa-chevron-right fa-fw dir-rtl-hide" aria-hidden="true"></i>
        <i class="icon fa fa-chevron-left fa-fw dir-ltr-hide" aria-hidden="true"></i>
        <span class="visually-hidden">{{#str}} next, core {{/str}}</span>
    </button>
</div>
