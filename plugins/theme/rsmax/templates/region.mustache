{{!
    @template theme_rsmax/region

    A landing block region. The label is only set while editing, to show where blocks can go.

    Context variables required for this template:
    * html - the rendered region
    * label - name of the region, empty when not editing

    Example context (json):
    {
        "html": "<aside class='block-region'></aside>",
        "label": "Above the content"
    }
}}
<div class="rsmax-region-wrapper{{#label}} rsmax-region-editing{{/label}} d-print-none">
    {{#label}}<div class="rsmax-region-label">{{label}}</div>{{/label}}
    {{{html}}}
</div>
