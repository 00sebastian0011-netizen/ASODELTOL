<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/asodeltolstaff/db" VERSION="20261025" COMMENT="Install schema for local_asodeltolstaff"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="local_asstaff_session" COMMENT="Scheduled, reported and administratively validated academic sessions">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="sectionnum" TYPE="int" LENGTH="5" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="groupid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="trainerid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="sessioncode" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="scheduledstart" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="scheduledend" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="reportedstart" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="reportedend" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="validatedminutes" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="validationstatus" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="pending" SEQUENCE="false"/>
        <FIELD NAME="evidenceref" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="createdby" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="validatedby" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timevalidated" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="coursefk" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="groupfk" TYPE="foreign" FIELDS="groupid" REFTABLE="groups" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="coursecodeuniq" UNIQUE="true" FIELDS="courseid, sessioncode"/>
        <INDEX NAME="coursetimeidx" UNIQUE="false" FIELDS="courseid, scheduledstart"/>
        <INDEX NAME="traineridx" UNIQUE="false" FIELDS="trainerid"/>
        <INDEX NAME="groupidx" UNIQUE="false" FIELDS="groupid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_asstaff_attendance" COMMENT="Provisional student attendance declarations for a session">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="sessionid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="studentid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="32" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="reportedby" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="sessionfk" TYPE="foreign" FIELDS="sessionid" REFTABLE="local_asstaff_session" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="sessionstudentuniq" UNIQUE="true" FIELDS="sessionid, studentid"/>
        <INDEX NAME="studentidx" UNIQUE="false" FIELDS="studentid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_asstaff_history" COMMENT="Append-only business history for session and attendance changes">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="sessionid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="entitytype" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="entityid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="action" TYPE="char" LENGTH="32" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="payload" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="actorid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="subjectuserid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="reason" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="sessionfk" TYPE="foreign" FIELDS="sessionid" REFTABLE="local_asstaff_session" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="sessiontimeidx" UNIQUE="false" FIELDS="sessionid, timecreated"/>
        <INDEX NAME="actoridx" UNIQUE="false" FIELDS="actorid"/>
        <INDEX NAME="subjectuseridx" UNIQUE="false" FIELDS="subjectuserid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_asstaff_case" COMMENT="Private support requests with explicit ownership and assigned recipient">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="requesterid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="recipientid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="subject" TYPE="char" LENGTH="160" NOTNULL="true"/>
        <FIELD NAME="body" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="status" TYPE="char" LENGTH="16" NOTNULL="true" DEFAULT="open"/>
        <FIELD NAME="notificationid" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
      <INDEXES>
        <INDEX NAME="requestertime" UNIQUE="false" FIELDS="requesterid,timecreated"/>
        <INDEX NAME="recipientstatus" UNIQUE="false" FIELDS="recipientid,status"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_asstaff_caseevent" COMMENT="Support replies and status history; personal data managed by Privacy API">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="caseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="actorid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="action" TYPE="char" LENGTH="16" NOTNULL="true"/>
        <FIELD NAME="body" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="casefk" TYPE="foreign" FIELDS="caseid" REFTABLE="local_asstaff_case" REFFIELDS="id"/>
      </KEYS>
      <INDEXES><INDEX NAME="actoridx" UNIQUE="false" FIELDS="actorid"/></INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
