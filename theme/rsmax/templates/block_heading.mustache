{{!
    @template theme_rsmax/block_heading

    Heading shared by the Pluginia landing blocks.

    Context variables required for this template:
    * hasheading - true when there is a title or a subtitle
    * heading - title
    * subheading - text under the title

    Example context (json):
    {
        "hasheading": true,
        "heading": "Popular courses",
        "subheading": "Start learning today"
    }
}}
{{#hasheading}}
    <div class="pluginia-block-heading">
        {{#heading}}<h2>{{{heading}}}</h2>{{/heading}}
        {{#subheading}}<p>{{{subheading}}}</p>{{/subheading}}
    </div>
{{/hasheading}}
