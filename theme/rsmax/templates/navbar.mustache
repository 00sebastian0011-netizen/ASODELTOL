{{!
    @template theme_rsmax/navbar

    The top navigation bar: Boost's, with a search form that is always available.

    Example context (json):
    {
        "output": {
            "should_display_navbar_logo": true,
            "get_compact_logo_url": "http://placekitten.com/50/50",
            "navbar_search": "<form><input type='search'></form>",
            "navbar_plugin_output": "<div class='dropdown'>Messaging</div>"
        },
        "config": {
            "wwwroot": "#",
            "homeurl": "/my/"
        },
        "sitename": "Moodle Site",
        "navbar": {"style": "light", "isdark": false, "button": {"text": "Sign up", "url": "#"} },
        "mobileprimarynav": [
            {
                "text": "Dashboard",
                "url": "/my",
                "isactive": true
            }
        ]
    }
}}
<nav class="navbar fixed-top bg-body navbar-expand rsmax-navbar rsmax-navbar-{{navbar.style}}"{{#navbar.isdark}} data-bs-theme="dark"{{/navbar.isdark}} aria-label="{{#str}}sitemenubar, admin{{/str}}">
    <div class="container-fluid">
        <button class="navbar-toggler aabtn d-block d-md-none px-1 my-1 border-0" data-toggler="drawers" data-action="toggle" data-target="theme_boost-drawers-primary">
            <span class="navbar-toggler-icon"></span>
            <span class="visually-hidden">{{#str}}sidepanel, core{{/str}}</span>
        </button>

        <a href="{{{ config.homeurl }}}" class="navbar-brand d-none d-md-flex align-items-center m-0 me-4 p-0 aabtn">

            {{# output.should_display_navbar_logo }}
                <img src="{{output.get_compact_logo_url}}" class="logo me-1" alt="{{sitename}}">
            {{/ output.should_display_navbar_logo }}
            {{^ output.should_display_navbar_logo }}
                {{{ sitename }}}
            {{/ output.should_display_navbar_logo }}
        </a>
        {{#primarymoremenu}}
            <div class="primary-navigation">
                {{> core/primarymoremenu}}
            </div>
        {{/primarymoremenu}}

        {{# output.page_heading_menu}}
            <ul class="navbar-nav d-none d-md-flex my-1 px-1">
                <!-- page_heading_menu -->
                {{{ output.page_heading_menu }}}
            </ul>
        {{/output.page_heading_menu}}

        <div id="usernavigation" class="navbar-nav ms-auto h-100">
            {{{ output.navbar_search }}}
            {{#navbar.button}}
                <a class="btn btn-primary btn-sm rsmax-navbar-cta d-none d-md-inline-flex" href="{{url}}">{{{text}}}</a>
            {{/navbar.button}}
            {{#langmenu}}
                {{> theme_boost/language_menu }}
                <div class="divider border-start h-75 align-self-center mx-1"></div>
            {{/langmenu}}
            {{# output.colour_mode_menu }}
                {{{ . }}}
                <div class="divider border-start h-75 align-self-center mx-1"></div>
            {{/ output.colour_mode_menu }}
            {{{ output.edit_switch }}}
            {{# output.navbar_plugin_output }}
            {{{ . }}}
                <div class="divider border-start h-75 align-self-center mx-1"></div>
            {{/output.navbar_plugin_output}}
            {{#usermenu}}
                <div class="d-flex align-items-stretch usermenu-container" data-region="usermenu">
                    {{> core/user_menu }}
                </div>
            {{/usermenu}}
        </div>
    </div>
</nav>

{{> theme_boost/primary-drawer-mobile }}
