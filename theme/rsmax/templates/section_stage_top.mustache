{{!
    @template theme_rsmax/section_stage_top

    First line of the header of a section page: the way back to the course, which section of the
    course it is and the progress of the learner in the course.

    Context variables required for this template:
    * coursename, courseurl - the course
    * position, total - place of the section among those of the course
    * hascourseprogress, coursepercentage - progress of the learner in the course

    Example context (json):
    {
        "coursename": "Project management",
        "courseurl": "#",
        "position": 2,
        "total": 5,
        "hascourseprogress": true,
        "coursepercentage": 42
    }
}}
<div class="rsmax-stage-top d-print-none">
    <a class="rsmax-stage-course" href="{{courseurl}}">
        <i class="fa fa-arrow-left" aria-hidden="true"></i> {{{coursename}}}
    </a>
    {{#position}}
        <span class="rsmax-stage-kind">{{#str}} sectionposition, theme_rsmax, { "position": {{position}}, "total": {{total}} } {{/str}}</span>
    {{/position}}
    {{#hascourseprogress}}
        <span class="rsmax-stage-progress" role="progressbar" aria-valuenow="{{coursepercentage}}" aria-valuemin="0" aria-valuemax="100"
              aria-label="{{#str}} yourprogress, theme_rsmax {{/str}}">
            <span class="rsmax-stage-progressbar" aria-hidden="true"><span style="width: {{coursepercentage}}%"></span></span>
            {{coursepercentage}}%
        </span>
    {{/hascourseprogress}}
</div>
