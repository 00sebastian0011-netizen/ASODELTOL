{{!
    @template theme_rsmax/course_hero

    Header of the main page of a course: its image, category, name and teachers, with the learner's
    progress and the next activity to do.

    Context variables required for this template:
    * name, image, category, teachers - the course
    * progress - false, or an object with percentage, completed, total, iscomplete and next (false or name and url)

    Example context (json):
    {
        "name": "Project management",
        "image": "https://placekitten.com/1200/400",
        "category": "Business",
        "teachers": "Ana Lopez",
        "progress": {"percentage": 42, "completed": 6, "total": 14, "iscomplete": false,
            "next": {"name": "Schedule template", "url": "#"} }
    }
}}
<section class="rsmax-coursehero d-print-none"{{#image}} style="--rsmax-banner: url('{{image}}')"{{/image}}>
    <div class="rsmax-coursehero-inner">
        <div class="rsmax-coursehero-text">
            {{#category}}<div class="rsmax-coursehero-category">{{{category}}}</div>{{/category}}
            <h1 class="rsmax-coursehero-title">{{{name}}}</h1>
            {{#teachers}}
                <p class="rsmax-coursehero-teachers"><i class="fa fa-chalkboard-user" aria-hidden="true"></i> {{{teachers}}}</p>
            {{/teachers}}
        </div>
        {{#progress}}
            <div class="rsmax-coursehero-progress{{#iscomplete}} is-complete{{/iscomplete}}">
                <div class="rsmax-ring" style="--rsmax-ring: {{percentage}}" role="progressbar" aria-valuenow="{{percentage}}"
                     aria-valuemin="0" aria-valuemax="100" aria-label="{{#str}} yourprogress, theme_rsmax {{/str}}">
                    <span class="rsmax-ring-figure">{{percentage}}<small>%</small></span>
                </div>
                <div class="rsmax-coursehero-count">
                    <span class="rsmax-coursehero-label">{{#str}} yourprogress, theme_rsmax {{/str}}</span>
                    {{#iscomplete}}{{#str}} progresscomplete, theme_rsmax {{/str}}{{/iscomplete}}
                    {{^iscomplete}}{{#str}} progresscount, theme_rsmax, { "completed": {{completed}}, "total": {{total}} } {{/str}}{{/iscomplete}}
                </div>
            </div>
        {{/progress}}
    </div>
    {{#progress}}{{#next}}
        <a class="rsmax-coursehero-next" href="{{url}}">
            <span class="rsmax-coursehero-next-label">{{#str}} continuehere, theme_rsmax {{/str}}</span>
            <span class="rsmax-coursehero-next-name">{{{name}}}</span>
            <span class="rsmax-coursehero-next-arrow" aria-hidden="true"><i class="fa fa-arrow-right"></i></span>
        </a>
    {{/next}}{{/progress}}
</section>
