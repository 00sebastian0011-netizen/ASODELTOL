{{!
    @template theme_rsmax/enrol_hero

    Header of the landing page of a course, for somebody who is not in it yet.

    Context variables required for this template:
    * name, category, banner - the course
    * teachernames - names of its teachers, may be empty
    * rating - false, or average, count and stars (isfull, ishalf)
    * hasfacts, facts - list of icon, value, label and isdate (the label goes before a date)

    Example context (json):
    {
        "name": "Project management",
        "category": "Business",
        "banner": "https://placekitten.com/1600/400",
        "teachernames": "Ana Lopez",
        "rating": {"average": "4,5", "count": 12, "stars": [{"isfull": true}, {"isfull": true}, {"isfull": true}, {"isfull": true}, {"ishalf": true}]},
        "hasfacts": true,
        "facts": [{"icon": "fa-layer-group", "value": 5, "label": "sections"}, {"icon": "fa-list-check", "value": 20, "label": "activities"}]
    }
}}
<section class="rsmax-enrolhero d-print-none" style="--rsmax-banner: url('{{banner}}')">
    <div class="rsmax-enrolhero-inner">
        {{#category}}<div class="rsmax-coursehero-category">{{{category}}}</div>{{/category}}
        <h1 class="rsmax-enrolhero-title">{{{name}}}</h1>
        <div class="rsmax-enrolhero-meta">
            {{#rating}}
                <span class="rsmax-enrolhero-rating">
                    <span class="rsmax-stars" aria-hidden="true">{{#stars}}<i class="fa {{#isfull}}fa-star{{/isfull}}{{#ishalf}}fa-star-half-stroke{{/ishalf}}{{^isfull}}{{^ishalf}}fa-star is-empty{{/ishalf}}{{/isfull}}"></i>{{/stars}}</span>
                    <b>{{average}}</b>
                    <span>{{#str}} enrolratings, theme_rsmax, {{count}} {{/str}}</span>
                </span>
            {{/rating}}
            {{#teachernames}}
                <span class="rsmax-enrolhero-teachers"><i class="fa fa-chalkboard-user" aria-hidden="true"></i> {{{teachernames}}}</span>
            {{/teachernames}}
        </div>
    </div>
    {{#hasfacts}}
        <ul class="rsmax-enrolhero-facts list-unstyled">
            {{#facts}}
                <li>
                    <i class="fa {{icon}}" aria-hidden="true"></i>
                    {{#isdate}}<span>{{label}} <b>{{value}}</b></span>{{/isdate}}
                    {{^isdate}}<span><b>{{value}}</b> {{label}}</span>{{/isdate}}
                </li>
            {{/facts}}
        </ul>
    {{/hasfacts}}
</section>
