root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{php,js,css,scss}]
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,xml}]
indent_style = space
indent_size = 2

[*.ps1]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

