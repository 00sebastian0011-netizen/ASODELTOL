[Unit]
Description=ASODELTOL bounded QA validation worker (one job per activation)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=user
Group=user
EnvironmentFile=/etc/asodeltol-validation-worker.env
WorkingDirectory=/opt/asodeltol-validation-worker
ExecStart=/usr/bin/node /opt/asodeltol-validation-worker/validation_executor.mjs --once
TimeoutStartSec=180s
TimeoutStopSec=15s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M
TasksMax=64
CPUQuota=80%
ReadWritePaths=/var/lib/asodeltol-validation
UMask=0077

[Install]
WantedBy=multi-user.target
